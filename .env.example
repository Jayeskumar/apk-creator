# ---------------------------------------------------------------- deployment
# onprem: SQLite + local disk + embedded build worker by default
# cloud:  expects Postgres + S3 and separate worker processes
DEPLOYMENT_MODE=onprem
PORT=8080
# URL phones use to reach this server (download links, lead capture from apps)
PUBLIC_URL=http://localhost:8080
BRAND_NAME=APK Creator
DATA_DIR=./data
# Required in cloud mode (all replicas must share it). On-prem: auto-generated.
SECRET_KEY=

# ---------------------------------------------------------------- accounts
ALLOW_SIGNUP=true
# Optional bootstrap administrator (otherwise the first sign-up becomes admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
MAX_APPS_PER_USER=0
MAX_BUILDS_PER_DAY=0
MAX_UPLOAD_MB=5

# ---------------------------------------------------------------- database
# Empty = SQLite in DATA_DIR. Set for PostgreSQL:
DATABASE_URL=
DATABASE_SSL=false

# ---------------------------------------------------------------- storage
STORAGE_DRIVER=local
# S3 / MinIO / R2 / GCS (interop) when STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
S3_PREFIX=

# ---------------------------------------------------------------- builds
EMBEDDED_WORKER=true
WORKER_CONCURRENCY=1
ANDROID_HOME=
GRADLE_CMD=gradle
GRADLE_OFFLINE=false
GRADLE_ARGS=
BUILD_TIMEOUT_SECONDS=900
KEEP_BUILD_DIRS=false

# ---------------------------------------------------------------- AI / developer modes
# Who may compile uploaded Gradle projects (their build scripts run on the worker):
# off | admin | all. Default: admin on-premise, off in the cloud.
PROJECT_BUILDS=
PROJECT_GRADLE_OFFLINE=false
PROJECT_BUILD_TIMEOUT_SECONDS=1800
PROJECT_USE_GRADLE_WRAPPER=false
MAX_APP_FILES=600
MAX_APP_FILE_MB=5
MAX_APP_FILES_TOTAL_MB=40
