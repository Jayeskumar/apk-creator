{
  "name": "apk-creator-server",
  "version": "1.0.0",
  "private": true,
  "description": "APK Creator: no-code Android business app builder (API, web UI and build worker)",
  "license": "MIT",
  "type": "commonjs",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "worker": "node --disable-warning=ExperimentalWarning src/worker.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/*.test.js\"",
    "create-admin": "node --disable-warning=ExperimentalWarning src/cli.js create-admin"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "pg": "^8.13.1"
  }
}
